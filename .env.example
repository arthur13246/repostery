# Copiez ce fichier en .env.local pour tester en local (ne jamais committer .env.local).
# Sur Vercel : Project Settings > Environment Variables.

# --- Connexion administrateur ---
ADMIN_EMAIL=arthurobert2013@gmail.com
ADMIN_PASSWORD=choisissez-un-mot-de-passe-fort
# Chaîne secrète aléatoire (ex: générée avec `openssl rand -hex 32`), sert de jeton de session admin
ADMIN_TOKEN=remplacez-par-une-longue-chaine-aleatoire

# --- Stripe (paiement réel) ---
# Récupérées dans le Dashboard Stripe > Developers > API keys
# Commencez avec les clés "Test" (sk_test_...) avant de passer en clés "Live" (sk_live_...)
STRIPE_SECRET_KEY=sk_test_votre_cle_ici
# Générée automatiquement par Stripe CLI en local, ou dans Developers > Webhooks une fois déployé
STRIPE_WEBHOOK_SECRET=whsec_votre_cle_ici

# --- Vercel KV (base de données partagée) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
